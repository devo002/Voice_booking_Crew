# Copy this file to .env and fill in your key.

# Any provider CrewAI/LiteLLM supports works here (OpenAI, Anthropic, etc).
# Pick one and set MODEL to match its provider prefix.
#
# OPENAI_API_KEY is also required for voice booking regardless of which
# provider MODEL points at -- server.py calls OpenAI's Whisper API
# directly to transcribe speech, and Anthropic has no equivalent.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which model the three agents use. Keep it cheap while you're iterating
# on the self-correction logic -- it doesn't need a big model to work.
# OpenAI:    MODEL=gpt-4o-mini
# Anthropic: MODEL=anthropic/claude-haiku-4-5-20251001
MODEL=anthropic/claude-haiku-4-5-20251001

# Quiets CrewAI's telemetry network calls, which are noisy in a sandboxed
# or offline dev environment and irrelevant to this project.
CREWAI_DISABLE_TELEMETRY=true

# "mock" (default if unset) uses an in-memory, single-user calendar --
# no setup needed, what main.py's CLI demo and the eval suite use.
# "supabase" switches server.py to a real, persisted, per-user calendar;
# requires a Supabase project (see booking_crew/supabase_calendar.py) and
# the three values below, from Project Settings -> API / Data API.
CALENDAR_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
